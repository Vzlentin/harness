{
	"name": "@vzlentin/harness",
	"version": "0.6.2",
	"description": "A durable agent harness on Pi, starting with observable, persistent subagents",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Vzlentin/harness.git"
	},
	"type": "module",
	"bin": {
		"harness": "dist/cli.js"
	},
	"exports": {
		"./answer": {
			"types": "./dist/children/respond.d.ts",
			"default": "./dist/children/respond.js"
		},
		"./answers": {
			"types": "./dist/answers.d.ts",
			"default": "./dist/answers.js"
		},
		"./children": {
			"types": "./dist/children/library.d.ts",
			"default": "./dist/children/library.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./durable-entry": {
			"types": "./dist/durable-entry.d.ts",
			"default": "./dist/durable-entry.js"
		},
		"./entries": {
			"types": "./dist/entries.d.ts",
			"default": "./dist/entries.js"
		},
		"./herdr": {
			"types": "./dist/herdr.d.ts",
			"default": "./dist/herdr.js"
		},
		"./host": {
			"types": "./dist/host.d.ts",
			"default": "./dist/host.js"
		},
		"./mirror": {
			"types": "./dist/mirror.d.ts",
			"default": "./dist/mirror.js"
		},
		"./overlay": {
			"types": "./dist/children/overlay.d.ts",
			"default": "./dist/children/overlay.js"
		},
		"./projects": {
			"types": "./dist/projects.d.ts",
			"default": "./dist/projects.js"
		},
		"./protocol": {
			"types": "./dist/protocol-subpath.d.ts",
			"default": "./dist/protocol-subpath.js"
		},
		"./tool": {
			"types": "./dist/tool.d.ts",
			"default": "./dist/tool.js"
		},
		"./trust": {
			"types": "./dist/children/trust.d.ts",
			"default": "./dist/children/trust.js"
		},
		"./view-state": {
			"types": "./dist/view-state.d.ts",
			"default": "./dist/view-state.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepack": "npm run build",
		"check": "biome check . && oxlint --deny-warnings && npm run build && tsc -p tsconfig.json && vitest --run --passWithNoTests",
		"test": "vitest --run --passWithNoTests"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-codemode": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"jiti": "2.7.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@oxlint/plugins": "1.88.0",
		"@types/node": "26.6.4",
		"oxlint": "1.88.0",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
