{
	"name": "@vzlentin/harness",
	"version": "0.6.2",
	"description": "A durable agent harness on Pi, starting with observable, persistent subagents",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Vzlentin/harness.git"
	},
	"bin": {
		"harness": "dist/cli.js"
	},
	"files": [
		"dist",
		"python/*.py",
		"web"
	],
	"type": "module",
	"exports": {
		"./answers": {
			"types": "./dist/client/answers.d.ts",
			"default": "./dist/client/answers.js"
		},
		"./children": {
			"types": "./dist/children/library.d.ts",
			"default": "./dist/children/library.js"
		},
		"./client": {
			"types": "./dist/client/client.d.ts",
			"default": "./dist/client/client.js"
		},
		"./durable-entry": {
			"types": "./dist/host/durable-entry.d.ts",
			"default": "./dist/host/durable-entry.js"
		},
		"./entries": {
			"types": "./dist/protocol/entries.d.ts",
			"default": "./dist/protocol/entries.js"
		},
		"./herdr": {
			"types": "./dist/client/herdr.d.ts",
			"default": "./dist/client/herdr.js"
		},
		"./host": {
			"types": "./dist/host/run.d.ts",
			"default": "./dist/host/run.js"
		},
		"./inspect": {
			"types": "./dist/inspect/index.d.ts",
			"default": "./dist/inspect/index.js"
		},
		"./mirror": {
			"types": "./dist/client/mirror.d.ts",
			"default": "./dist/client/mirror.js"
		},
		"./overlay": {
			"types": "./dist/children/overlay.d.ts",
			"default": "./dist/children/overlay.js"
		},
		"./projects": {
			"types": "./dist/protocol/projects.d.ts",
			"default": "./dist/protocol/projects.js"
		},
		"./protocol": {
			"types": "./dist/protocol/index.d.ts",
			"default": "./dist/protocol/index.js"
		},
		"./respond": {
			"types": "./dist/children/respond.d.ts",
			"default": "./dist/children/respond.js"
		},
		"./rlm": {
			"types": "./dist/rlm/index.d.ts",
			"default": "./dist/rlm/index.js"
		},
		"./tasks": {
			"types": "./dist/host/tasks.d.ts",
			"default": "./dist/host/tasks.js"
		},
		"./todo": {
			"types": "./dist/host/todo.d.ts",
			"default": "./dist/host/todo.js"
		},
		"./tool": {
			"types": "./dist/tool.d.ts",
			"default": "./dist/tool.js"
		},
		"./trust": {
			"types": "./dist/protocol/trust.d.ts",
			"default": "./dist/protocol/trust.js"
		},
		"./view-state": {
			"types": "./dist/client/view-state.d.ts",
			"default": "./dist/client/view-state.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"prepare": "npm run build",
		"prepack": "npm run build",
		"check": "npm run build && vp check --deny-warnings && tsc -p tsconfig.json && vp test",
		"test": "vp test"
	},
	"dependencies": {
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-codemode": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"jiti": "2.7.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@types/node": "26.6.4",
		"typescript": "7.0.2",
		"vite-plus": "1.5.0"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
