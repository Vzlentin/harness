{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": [
		".agent/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".continue/**",
		".cursor/**",
		".gemini/**",
		".opencode/**",
		".pi/**",
		".roo/**",
		".windsurf/**",
		"tools/oxlint/anti-slop/**"
	],
	"jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }],
	"rules": {
		"oxc/no-accumulating-spread": "error",
		"anti-slop/no-array-filter-map": "error",
		"anti-slop/no-reduce-accumulator-copy": "error",
		"anti-slop/no-chained-type-assertions": "error",
		"anti-slop/no-conditional-empty-object-spread": "error",
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-module-mocking": "error",
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-reflect-apply": "error",
		"anti-slop/no-reflect-get": "error",
		"anti-slop/no-runtime-typeof": "error",
		"anti-slop/no-shape-in-symbol-names": "error",
		"anti-slop/no-unknown-parameters": "error",
		"anti-slop/no-unknown-returns": "error",
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error",
		"anti-slop/require-readable-spacing": "error",
		"anti-slop/require-safety-comment-for-type-assertion": "error"
	},
	"overrides": [
		{
			"files": ["pi/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^\\.\\./dist/",
								"allowTypeImports": true,
								"message": "pi/ is published without dist/: import its types only, and take the modules from the Harness object."
							},
							{
								"group": ["../dist/**", "!../dist/protocol/**", "!../dist/client/**", "!../dist/tool.js"],
								"message": "pi/ loads only protocol/, client/ and tool.ts."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/protocol/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["../**"],
								"message": "protocol/ imports nothing else from src/."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/children/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["../**", "!../protocol/**"],
								"message": "children/ imports only protocol/ from src/."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/client/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["../**", "!../protocol/**"],
								"message": "client/ imports only protocol/ from src/."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/rlm/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["../**", "!../protocol/**", "!../tool.ts"],
								"message": "rlm/ imports only protocol/ and tool.ts from src/."
							},
							{
								"group": ["@earendil-works/**"],
								"allowTypeImports": true,
								"message": "The Pi extension loads rlm/ from dist/: import the types of Pi packages only."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/host/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["../**", "!../protocol/**", "!../children/**", "!../rlm/**", "!../tool.ts"],
								"message": "host/ imports only protocol/, children/, rlm/ and tool.ts."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/host/durable-entry.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["../**", "!../protocol/**", "!../children/**", "!../rlm/**", "!../tool.ts"],
								"message": "host/ imports only protocol/, children/, rlm/ and tool.ts."
							},
							{
								"group": ["@earendil-works/*"],
								"allowTypeImports": true,
								"message": "The durable entry runs on the host's pi-durable and pi-ai: import their types only, and take the modules from the options."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/tool.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["./**", "../**", "!./protocol/**", "!./client/**"],
								"message": "tool.ts imports only protocol/ and client/."
							}
						]
					}
				]
			}
		}
	]
}
